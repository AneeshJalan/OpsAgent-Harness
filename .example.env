# Copy this file to `.env` in the repo root and fill in real values.
# `.env` itself is git-ignored -- never commit real credentials.

# Required to run the agent loop (agent/loop.py) against the real Anthropic API.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. Overrides which SQLite file the tool layer reads and writes (db/database.py).
# The eval harness sets this itself, per case, to point at a fresh copy of the golden DB --
# only set it by hand for local debugging against one specific database file.
# OPS_DB_PATH=db/opsagent.db
